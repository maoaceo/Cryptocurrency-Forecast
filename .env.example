# Dashboard: choose a unique strong password before startup.
APP_PASSWORD=
# Docker host port; use 18790 for an isolated test deployment.
APP_PORT=8790
# Session cookie Secure follows HTTPS / X-Forwarded-Proto=https automatically.
PUBLIC_READONLY=0
DB_PATH=/app/data/trader.db

# Official Binance SAPI; dashboard binance_api fields override these fallbacks.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_ENABLED=1

# Search briefing: vertex_grounding (default) or openai_compatible.
SEARCH_API_PROVIDER=vertex_grounding
SEARCH_API_BASE_URL=
SEARCH_API_API_KEY=
SEARCH_API_MODEL=
VERTEX_SA_JSON=/app/secrets/vertex-sa.json

# CPA LLM voter fallbacks (base URL may include /v1).
CPA_BASE_URL=
CPA_API_KEY=
CPA_ASTRA_MODEL=gpt-6-astra
CPA_ASTRA_ENABLED=1
CPA_SOL_MODEL=gpt-6.1-sol
CPA_SOL_ENABLED=1

# WorkBuddy LLM voter fallback.
WB_BASE_URL=
WB_API_KEY=
WB_MODEL=deepseek-v4.1-flash
WB_ENABLED=1

# sapi (default) or baw; dashboard executor_mode takes priority.
# Bridge URL/token are environment-only. Set a separate strong token on app and bridge.
EXECUTOR_PATH=sapi
BAW_BRIDGE_URL=http://host.docker.internal:8791
BAW_BRIDGE_TOKEN=
BAW_BRIDGE_ENABLED=1

# Host bridge process only; also documented in bridge/bridge.env.example.
BAW_BIN=baw
BAW_BRIDGE_BIND=127.0.0.1
BAW_BRIDGE_PORT=8791
BAW_BRIDGE_LEDGER=/opt/prediction-autotrader/bridge/bridge_ledger.json
